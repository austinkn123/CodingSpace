<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>BudgetTracker.Engines.Tests</RootNamespace>
  </PropertyGroup>

  <!-- 
    TDD PHASE 1: Classic TDD
    Tests reference Contracts (for models) and Engines (for implementations).
    No mocking needed — Engines are pure logic.
  -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BudgetTracker\BudgetTracker.Contracts\BudgetTracker.Contracts.csproj" />
    <ProjectReference Include="..\..\src\BudgetTracker\BudgetTracker.Engines\BudgetTracker.Engines.csproj" />
  </ItemGroup>

</Project>
